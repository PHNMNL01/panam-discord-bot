DISCORD_BOT_TOKEN=your_discord_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here

# Volitelne:
# Pro rychlejsi registraci slash commandu zadej ID Discord serveru.
# Vice serveru oddel carkou. Kdyz nechas prazdne, command se syncuje globalne.
DISCORD_GUILD_IDS=

# Volitelne:
# Kanaly, ve kterych smi bot odpovidat na /ask. Vice kanalu oddel carkou.
# Kdyz nechas prazdne, bot muze odpovidat ve vsech kanalech.
ALLOWED_CHANNEL_IDS=

OPENAI_MODEL=gpt-5.4-mini
OPENAI_PROMPT_ID=
OPENAI_PROMPT_VERSION=
